# Supabase (Project settings -> API). Without these the site runs on sample listings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin moderation area (/admin) - HTTP basic auth
ADMIN_USER=
ADMIN_PASSWORD=

# Hosted payment links from your adult-friendly processor (CCBill / Segpay / Verotel).
# Sellers are only sent these AFTER their listing is approved.
PAYMENT_LINK_STANDARD=
PAYMENT_LINK_BROKERED=
PAYMENT_LINK_DELIVERY=

# Email notifications (Brevo transactional) - optional
BREVO_API_KEY=
NOTIFY_EMAIL=hello@sellmydoll.com

NEXT_PUBLIC_SITE_URL=https://sellmydoll.com
